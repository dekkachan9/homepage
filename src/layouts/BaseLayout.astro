---
import Navigation from '../components/Navigation.astro';
import defaultHero from '../assets/images/hero02.png';

const { pageTitle, heroImage = defaultHero, heroPosition = "center" } = Astro.props;
---

<html lang="ja">
   <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/favicon5.png" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1EEVE633MC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1EEVE633MC');
    </script>
  </head>
  
  <body>
    <Navigation />
    <slot />
  </body>
</html>


<style define:vars={{ heroBg: `url(${heroImage.src})`, heroPosition }} is:global>
  body {
    background-color: #2b2b2b;
    color: #b3b3b3;
    margin: 0;
    font-family: "Hiragino Mincho ProN", "Yu Mincho", serif;
  }

  body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-image: var(--heroBg);
    background-size: cover;
    background-position: var(--heroPosition);
    z-index: -1;
  }
</style>
