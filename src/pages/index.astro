---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Home Page";

const newsItems = [
  { date: "2026.09.20", text: '10/3(土)4(日)<a href="https://artcenter-new.jp/event/new_bookfair_picnic/" target="_blank" rel="noopener noreferrer">ニューBook Fair @Art Center New</a>に出展します' },
  { date: "2026.09.19", text: '9/26(土)<a href="https://note.com/bookcultureclub/n/na022cade2895" target="_blank" rel="noopener noreferrer">ZINE FEST東京</a>に出展します' },
];
---
<BaseLayout pageTitle={pageTitle} heroPosition="25% center">
  <section class="news">
    <h2>News</h2>
    <ul>
      {newsItems.map((item) => (
        <li>
          <span class="date">{item.date}</span>
          <span class="text" set:html={item.text}></span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
.news {
  max-width: 600px;
  margin: 3rem auto;
  padding: 0 3rem;
}
  .news h2 {
    font-size: 1rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
  .news ul {
    list-style: none;
    padding: 0;
  }
  .news li {
    display: flex;
    gap: 1.5rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid #444;
    font-size: 0.85rem;
  }
  .news .date {
    color: #888;
    flex-shrink: 0;
  }
  .news .text :global(a) {
    color: inherit;
    text-decoration: underline;
  }
</style>
