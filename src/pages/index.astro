---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Home Page";

const newsItems = [
  { date: "2026.11.03", text: '11/16(月)〜11/29(日)<a href="https://www.instagram.com/gallery_bar_yohaku/" target="_blank" rel="noopener noreferrer">Gallery Bar 余白</a>で個展をします' }
];
---
<BaseLayout pageTitle={pageTitle} heroPosition="25% center">
  <section class="news">
    <h2>News</h2>
    <ul>
      {newsItems.map((item) => (
        <li>
          <span class="date">{item.date}</span>
          <span class="text" set:html={item.text}></span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
.news {
  max-width: 600px;
  margin: 3rem auto;
  padding: 0 3rem;
}
  .news h2 {
    font-size: 1rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
  .news ul {
    list-style: none;
    padding: 0;
  }
  .news li {
    display: flex;
    gap: 1.5rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid #444;
    font-size: 0.85rem;
  }
  .news .date {
    color: #888;
    flex-shrink: 0;
  }
  .news .text :global(a) {
    color: inherit;
    text-decoration: underline;
  }
</style>
