---
import BaseLayout from '../layouts/BaseLayout.astro';
import hero03 from '../assets/images/hero03.png';

const pageTitle = "Blog";
---
<BaseLayout pageTitle={pageTitle} heroImage={hero03}>
  <section class="content">
    <h2>Blog</h2>
    <p>ここにブログ記事を並べます</p>
  </section>
</BaseLayout>

<style>
  .content {
    max-width: 600px;
    margin: 3rem auto;
    padding: 0 3rem;
  }
  .content h2 {
    font-size: 1rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
</style>
