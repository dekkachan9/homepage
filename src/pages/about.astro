---
import BaseLayout from '../layouts/BaseLayout.astro';
import hero00 from '../assets/images/hero00.png';

const pageTitle = "About";
---
<BaseLayout pageTitle={pageTitle} heroImage={hero00}>
  <section class="content">
    <h2>About</h2>
    <p>ここに自己紹介を書きます</p>
  </section>
</BaseLayout>

<style>
  .content {
    max-width: 600px;
    margin: 3rem auto;
    padding: 0 3rem;
  }
  .content h2 {
    font-size: 1rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
</style>